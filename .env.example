DB_HOST=localhost
DB_PORT=3306
DB_NAME=kaspindo
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Domain pusat KASPINDO. Wajib untuk mode SaaS/custom domain.
APP_URL=https://kaspindo.example.com
APP_PRIMARY_HOST=kaspindo.example.com

# Jika Cloudflare Tunnel/domain publik memakai HTTPS tapi service lokal memakai HTTP.
APP_FORCE_HTTPS=1

# Kosongkan jika document root langsung ke folder public/.
# Isi misalnya /kaspindo/public hanya untuk setup subfolder lokal.
APP_BASE_PATH=

# Host tambahan yang dianggap domain pusat, pisahkan dengan koma.
APP_PLATFORM_HOSTS=localhost,127.0.0.1

# Target DNS/CNAME yang harus dipakai domain mitra.
APP_DOMAIN_TARGET=kaspindo.example.com

# Fitur support chat internal. Default production disarankan 0 bila tidak ada alur support mitra.
APP_SUPPORT_ENABLED=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI / Codex-ready AI Assistant. Isi hanya di server, jangan expose ke client.
AI_ASSISTANT_ENABLED=0
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=
OPENAI_PROJECT=
AI_REASONING_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_SECONDS=30

# E2E browser test lokal/staging. Jangan isi credential production di file yang ikut repository.
E2E_BASE_URL=http://localhost/kaspindo/public
E2E_SUPERADMIN_USER=
E2E_SUPERADMIN_PASS=
E2E_ADMIN_USER=
E2E_ADMIN_PASS=
E2E_BOS_USER=
E2E_BOS_PASS=
E2E_KASIR_USER=
E2E_KASIR_PASS=
E2E_RUN_OPERATIONAL=0
E2E_RUN_INTEGRATIONS=0
E2E_CUSTOM_DOMAIN_TEST=
